
/* Question 13(a): Bubble Sort */
#include <stdio.h>

int main() {
    int a[100], n, i, j, temp;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    // Compare and swap adjacent elements
    for(i = 0; i < n-1; i++) {
        for(j = 0; j < n-i-1; j++) {
            if(a[j] > a[j+1]) {
                temp = a[j];
                a[j] = a[j+1];
                a[j+1] = temp;
            }
        }
    }

    printf("Sorted array: ");
    for(i = 0; i < n; i++)
        printf("%d ", a[i]);

    return 0;
}

/* Question 13(b): Selection Sort */
#include <stdio.h>

int main() {
    int a[100], n, i, j, min, temp;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    // Find the smallest element and place it
    for(i = 0; i < n-1; i++) {
        min = i;
        for(j = i+1; j < n; j++) {
            if(a[j] < a[min])
                min = j;
        }

        temp = a[i];
        a[i] = a[min];
        a[min] = temp;
    }

    printf("Sorted array: ");
    for(i = 0; i < n; i++)
        printf("%d ", a[i]);

    return 0;
}

/* Question 13(c): Insertion Sort */
#include <stdio.h>

int main() {
    int a[100], n, i, j, key;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    // Insert each element into its correct position
    for(i = 1; i < n; i++) {
        key = a[i];
        j = i-1;

        while(j >= 0 && a[j] > key) {
            a[j+1] = a[j];
            j--;
        }
        a[j+1] = key;
    }

    printf("Sorted array: ");
    for(i = 0; i < n; i++)
        printf("%d ", a[i]);

    return 0;
}

/* Question 13(d): Non-recursive Quick Sort */
#include <stdio.h>

int main() {
    int a[100], stack[200], n, i;
    int top = -1, low, high, p, j, temp;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    // Store array ranges in a stack
    stack[++top] = 0;
    stack[++top] = n-1;

    while(top >= 0) {
        high = stack[top--];
        low = stack[top--];

        i = low;
        p = a[high];  // Choose last element as pivot

        // Partition the array
        for(j = low; j < high; j++) {
            if(a[j] < p) {
                temp = a[i];
                a[i] = a[j];
                a[j] = temp;
                i++;
            }
        }

        temp = a[i];
        a[i] = a[high];
        a[high] = temp;

        // Add left and right ranges to the stack
        if(i-1 > low) {
            stack[++top] = low;
            stack[++top] = i-1;
        }
        if(i+1 < high) {
            stack[++top] = i+1;
            stack[++top] = high;
        }
    }

    printf("Sorted array: ");
    for(i = 0; i < n; i++)
        printf("%d ", a[i]);

    return 0;
}

/* Question 13(e): Shell Sort */
#include <stdio.h>

int main() {
    int a[100], n, i, j, gap, temp;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    // Reduce the gap after each pass
    for(gap = n/2; gap > 0; gap /= 2) {
        for(i = gap; i < n; i++) {
            temp = a[i];
            j = i;

            // Shift larger elements by the gap
            while(j >= gap && a[j-gap] > temp) {
                a[j] = a[j-gap];
                j -= gap;
            }
            a[j] = temp;
        }
    }

    printf("Sorted array: ");
    for(i = 0; i < n; i++)
        printf("%d ", a[i]);

    return 0;
}

/* Question 13(g): Non-recursive Merge Sort */
#include <stdio.h>

int main() {
    int a[100], temp[100], n, i, size;
    int left, mid, right, x, y, k;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    // Merge smaller sorted sections into larger sections
    for(size = 1; size < n; size *= 2) {
        for(left = 0; left < n-1; left += 2*size) {
            mid = left + size-1;
            right = left + 2*size-1;

            if(mid >= n-1)
                continue;
            if(right >= n)
                right = n-1;

            x = left;
            y = mid+1;
            k = left;

            // Merge the two sorted sections
            while(x <= mid && y <= right) {
                if(a[x] <= a[y])
                    temp[k++] = a[x++];
                else
                    temp[k++] = a[y++];
            }

            while(x <= mid)
                temp[k++] = a[x++];

            while(y <= right)
                temp[k++] = a[y++];

            for(i = left; i <= right; i++)
                a[i] = temp[i];
        }
    }

    printf("Sorted array: ");
    for(i = 0; i < n; i++)
        printf("%d ", a[i]);

    return 0;
}
