
#include <stdio.h>

int main() {
    int a[100], n, i, key, found = 0;
    int low, high, mid, choice;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements in sorted order:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter element to search: ");
    scanf("%d", &key);

    printf("1. Sequential Search\n");
    printf("2. Binary Search\n");
    printf("Enter choice: ");
    scanf("%d", &choice);

    if(choice == 1) {
        for(i = 0; i < n; i++) {
            if(a[i] == key) {
                found = 1;
                break;
            }
        }

        if(found)
            printf("Element found at position %d", i + 1);
        else
            printf("Element not found");
    }
    else if(choice == 2) {
        low = 0;
        high = n - 1;

        while(low <= high) {
            mid = (low + high) / 2;

            if(a[mid] == key) {
                found = 1;
                break;
            }
            else if(a[mid] < key)
                low = mid + 1;
            else
                high = mid - 1;
        }

        if(found)
            printf("Element found at position %d", mid + 1);
        else
            printf("Element not found");
    }
    else {
        printf("Invalid choice");
    }

    return 0;
}
