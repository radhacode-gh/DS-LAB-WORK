
#include <stdio.h>
#include <string.h>
#define MAX 100

char stack[MAX];
int top = -1;

// Push character into stack
void push(char ch)
{
    if (top < MAX - 1)
        stack[++top] = ch;
}

// Pop character from stack
char pop()
{
    if (top == -1)
        return '\0';

    return stack[top--];
}

// Check matching brackets
int isValid(char s[])
{
    int i;
    char ch;

    for (i = 0; s[i] != '\0'; i++)
    {
        if (s[i] == '(' || s[i] == '{' || s[i] == '[')
            push(s[i]);

        else if (s[i] == ')' || s[i] == '}' || s[i] == ']')
        {
            ch = pop();

            if ((s[i] == ')' && ch != '(') ||
                (s[i] == '}' && ch != '{') ||
                (s[i] == ']' && ch != '['))
                return 0;
        }
    }

    return top == -1;
}

int main()
{
    char s[MAX];

    printf("Enter expression: ");
    scanf("%99s", s);

    top = -1;  // Start with an empty stack

    if (isValid(s))
        printf("Valid Parentheses\n");
    else
        printf("Invalid Parentheses\n");

    return 0;
}
