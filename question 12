
#include <stdio.h>
#define SIZE 10

int main() {
    int hash[SIZE], n, key, i, index, count;

    for(i = 0; i < SIZE; i++)
        hash[i] = -1;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++) {
        printf("Enter key: ");
        scanf("%d", &key);

        index = key % SIZE;
        count = 0;

        while(hash[index] != -1 && count < SIZE) {
            index = (index + 1) % SIZE;
            count++;
        }

        if(count == SIZE)
            printf("Hash table is full\n");
        else
            hash[index] = key;
    }

    printf("\nHash Table:\n");
    for(i = 0; i < SIZE; i++) {
        if(hash[i] == -1)
            printf("%d : Empty\n", i);
        else
            printf("%d : %d\n", i, hash[i]);
    }

    return 0;
}
