#include <stdio.h>
#include <stdlib.h>

#define N 3 // Define matrix size

// Function to multiply two matrices
void multiplyMatrices(int mat1[][N], int mat2[][N], int res[][N]) {
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            res[i][j] = 0;
            for (int k = 0; k < N; k++) {
                res[i][j] += mat1[i][k] * mat2[k][j];
            }
        }
    }
}

// Function to find difference of sums of diagonals
int diagonalDifference(int mat[][N]) {
    int primarySum = 0, secondarySum = 0;
    for (int i = 0; i < N; i++) {
        primarySum += mat[i][i];
        secondarySum += mat[i][N - 1 - i];
    }
    return abs(primarySum - secondarySum);
}

int main() {
    int mat1[N][N] = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};
    int mat2[N][N] = {{9, 8, 7}, {6, 5, 4}, {3, 2, 1}};
    int res[N][N];

    multiplyMatrices(mat1, mat2, res);

    printf("Result of Matrix Multiplication:\n");
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            printf("%d\t", res[i][j]);
        }
        printf("\n");
    }

    int diff = diagonalDifference(mat1);
    printf("\nAbsolute difference of diagonal sums of Matrix 1: %d\n", diff);

    return 0;
}
